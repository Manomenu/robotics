# --- colcon: wszystko odtwarzalne z ws/src ---
ws/build/
ws/install/
ws/log/

# --- python ---
__pycache__/
*.pyc
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- dane z przebiegów: duże i odtwarzalne, trzymane poza gitem ---
**/bags/
